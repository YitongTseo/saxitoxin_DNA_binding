 FOR-clause=                       resn DA  or resn DC  or resn DG  or resn DT  or resn DJ )) loop search 
 CNSsolve> 
 CNSsolve>         pick bond (id $id1) (id $id2) geometry 
 CNSsolve>         evaluate ($upper = $result) 
 CNSsolve>         show (segid) (id $id2) 
 CNSsolve>         evaluate ($segid2=$result) 
 CNSsolve>         show (resid) (id $id2) 
 CNSsolve>         evaluate ($resid2=$result) 
 CNSsolve>         show (name) (id $id2) 
 CNSsolve>         evaluate ($name2=$result) 
 CNSsolve> 
 CNSsolve>         if ($segid1 eq $segid2) then 
 CNSsolve>             noe 
 CNSsolve>                 assign (resid $resid1 and segid $segid1 and name $name1) 
 CNSsolve>                        (resid $resid2 and segid $segid2 and name $name2) $upper 0.1 0.1 
 CNSsolve>             end 
 CNSsolve>         end if 
 CNSsolve> 
 CNSsolve>     end loop search 
 CNSsolve> 
 CNSsolve>   end loop sions 

 CNSsolve>   do (harmonic=0.0) (resn ANI and name X ) 
 CNSsolve>   do (harmonic=0.0) (resn ANI and name Y ) 
 CNSsolve>   do (harmonic=0.0) (resn ANI and name Z ) 
 CNSsolve>   do (harmonic=0.0) (not (resn ANI)) 

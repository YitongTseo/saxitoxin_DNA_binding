 CNSsolve>evaluate ($message_old_sclib=$result) 
 CNSsolve>set echo ? end 
 CNSsolve>evaluate ($echo_old_sclib=$result) 
 CNSsolve>set echo=off message=off end 
 CNSsolve> 

 CNSsolve>while ($ndani <= $Data.numdani) loop dani 
 CNSsolve>  if ($Data.dan_lastit_$ndani ge $Iteration) then 
 CNSsolve>    if ($Data.dan_firstit_$ndani le $Iteration) then 
 CNSsolve>      if ($Data.dan_choice_$ndani eq "DANI") then 

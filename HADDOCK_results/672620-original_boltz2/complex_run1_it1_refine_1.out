 CNSsolve>                eval ($ares_name = CYT) 
 CNSsolve>            end if 
 CNSsolve> 
 CNSsolve>            if ($ares_name = ADE) then 
 CNSsolve>                show sum(1) ( ((resn DT or resn T or resn U) and not (resid $presid or resid $fresid) and name N3) 
 CNSsolve>                               and (resid $resid and name N1) around $hbcut) 
 CNSsolve>                if ($result = 1) then 
 CNSsolve>                    show (resid) ( ((resn DT or resn T or resn U) and not (resid $presid or resid $fresid) and name N3) 
 CNSsolve>                                  and (resid $resid and name N1) around $hbcut) 
 CNSsolve>                    evaluate ($rpair = $result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N6) 
 CNSsolve>                        (resid $rpair and name O4) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n6o4=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N1) 
 CNSsolve>                        (resid $rpair and name N3) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n1n3=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N1) 
 CNSsolve>                        (resid $rpair and name O4) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n1o4=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N1) 
 CNSsolve>                        (resid $rpair and name O2) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n1o2=$result) 
 CNSsolve>                    noe 
 CNSsolve>                        assign (resid $resid and name N6) 
 CNSsolve>                               (resid $rpair and name O4) 
 CNSsolve>                               $n6o4 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name N1) 
 CNSsolve>                               (resid $rpair and name N3) 
 CNSsolve>                               $n1n3 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name N1) 
 CNSsolve>                               (resid $rpair and name O4) 
 CNSsolve>                               $n1o4 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name N1) 
 CNSsolve>                               (resid $rpair and name O2) 
 CNSsolve>                               $n1o2 $wc_low $wc_up 
 CNSsolve>                    end 
 CNSsolve>                end if 
 CNSsolve>            end if 
 CNSsolve> 
 CNSsolve>            !find possible pairing for DC/C with DG/G 
 CNSsolve>            if ($ares_name = CYT) then 
 CNSsolve>                show sum(1) ( ((resn DG or resn G) and not (resid $presid or resid $fresid) and name N1) 
 CNSsolve>                               and (resid $resid and name N3) around $hbcut) 
 CNSsolve>                if ($result = 1) then 
 CNSsolve>                    show (resid) ( ((resn DG or resn G) and not (resid $presid or resid $fresid) and name N1) 
 CNSsolve>                                  and (resid $resid and name N3) around $hbcut) 
 CNSsolve>                    evaluate ($rpair = $result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N3) 
 CNSsolve>                        (resid $rpair and name N1) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n3n1=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N4) 
 CNSsolve>                        (resid $rpair and name O6) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n4o6=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name O2) 
 CNSsolve>                        (resid $rpair and name N2) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($o2n2=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N3) 
 CNSsolve>                        (resid $rpair and name O6) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n3o6=$result) 
 CNSsolve>                    pick bond 
 CNSsolve>                        (resid $resid and name N3) 
 CNSsolve>                        (resid $rpair and name N2) 
 CNSsolve>                        geometry 
 CNSsolve>                    evaluate ($n3n2=$result) 
 CNSsolve>                    noe 
 CNSsolve>                        assign (resid $resid and name N3) 
 CNSsolve>                               (resid $rpair and name N1) $n3n1 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name N4) 
 CNSsolve>                               (resid $rpair and name O6) $n4o6 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name O2) 
 CNSsolve>                               (resid $rpair and name N2) $o2n2 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name N3) 
 CNSsolve>                               (resid $rpair and name O6) $n3o6 $wc_low $wc_up 
 CNSsolve>                        assign (resid $resid and name N3) 
 CNSsolve>                               (resid $rpair and name N2) $n3n2 $wc_low $wc_up 
 CNSsolve>                    end 
 CNSsolve>                end if 
 CNSsolve>            end if 
 CNSsolve>        end loop resid 
 CNSsolve>    end if 
 CNSsolve>end if 
 CNSsolve>end if 

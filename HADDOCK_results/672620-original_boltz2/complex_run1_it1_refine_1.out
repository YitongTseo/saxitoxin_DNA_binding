 CNSsolve>         display COVALION: ADDED ONE COVALENT BOND BETWEEN $name1 $resid1 AND $name2 $resname2 $resid2 
 CNSsolve>     end if 
 CNSsolve> 
 CNSsolve>     param bond $chem1 $chem2 0.0 $mindis end 
 CNSsolve> 
 CNSsolve>   end loop ions 

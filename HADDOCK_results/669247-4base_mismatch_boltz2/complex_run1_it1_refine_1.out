 CNSsolve>{=========================================================================================================} 
 CNSsolve>{                        things below this line do not normally need to be changed                        } 
 CNSsolve>{=========================================================================================================} 
 CNSsolve> 
 CNSsolve>{- Dihedral restraints for the protein backbone in alpha-beta regions -} 
 CNSsolve> 
 CNSsolve>  do (store1 = 1) (all) 
 CNSsolve>  restraint dihedral 
 CNSsolve>    nass = 50000 
 CNSsolve>  end 
 CNSsolve>  evaluate ($group=1) 
 CNSsolve>  evaluate ($done=false) 
 CNSsolve>  while ( $done = false ) loop bdihe 
 CNSsolve>   if ( $exist_Toppar.prot_segid_$group = true ) then 
 CNSsolve>     show sum(1) ( segid $Toppar.prot_segid_$group ) 
 CNSsolve>     if ( $result > 0 ) then 
 CNSsolve>       evaluate ($error_phi=$Data.error_dih) 
 CNSsolve>       evaluate ($error_psi=$Data.error_dih) 
 CNSsolve> 
 CNSsolve>       for $id in id ( segid $Toppar.prot_segid_$group and tag and not resn TIP* ) loop resid 
 CNSsolve>         show (segid) (id $id) 
 CNSsolve>         evaluate ($segid=$result) 

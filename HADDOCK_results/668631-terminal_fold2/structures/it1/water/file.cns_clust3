module(filenames;)
set message off echo off end
evaluate ($count = 1)
while ($count le 2000) loop main
   evaluate (&filenames.bestfile_$count = "")
   evaluate ($count = $count + 1)
end loop main
set message on echo on end
evaluate (&filenames.bestfile_1="PREVIT:complex_54w.pdb")
evaluate (&filenames.bestfile_2="PREVIT:complex_31w.pdb")
evaluate (&filenames.bestfile_3="PREVIT:complex_41w.pdb")
evaluate (&filenames.bestfile_4="PREVIT:complex_63w.pdb")
evaluate (&filenames.bestfile_5="PREVIT:complex_58w.pdb")
evaluate (&filenames.bestfile_6="PREVIT:complex_21w.pdb")
evaluate (&filenames.bestfile_7="PREVIT:complex_95w.pdb")
evaluate (&filenames.bestfile_8="PREVIT:complex_184w.pdb")
evaluate (&filenames.bestfile_9="PREVIT:complex_160w.pdb")
evaluate (&filenames.bestfile_10="PREVIT:complex_91w.pdb")
evaluate (&filenames.bestfile_11="PREVIT:complex_152w.pdb")

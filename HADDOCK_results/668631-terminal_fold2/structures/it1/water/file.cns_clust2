module(filenames;)
set message off echo off end
evaluate ($count = 1)
while ($count le 2000) loop main
   evaluate (&filenames.bestfile_$count = "")
   evaluate ($count = $count + 1)
end loop main
set message on echo on end
evaluate (&filenames.bestfile_1="PREVIT:complex_105w.pdb")
evaluate (&filenames.bestfile_2="PREVIT:complex_6w.pdb")
evaluate (&filenames.bestfile_3="PREVIT:complex_19w.pdb")
evaluate (&filenames.bestfile_4="PREVIT:complex_40w.pdb")
evaluate (&filenames.bestfile_5="PREVIT:complex_26w.pdb")
evaluate (&filenames.bestfile_6="PREVIT:complex_191w.pdb")
evaluate (&filenames.bestfile_7="PREVIT:complex_195w.pdb")
evaluate (&filenames.bestfile_8="PREVIT:complex_144w.pdb")
evaluate (&filenames.bestfile_9="PREVIT:complex_50w.pdb")
evaluate (&filenames.bestfile_10="PREVIT:complex_151w.pdb")
evaluate (&filenames.bestfile_11="PREVIT:complex_33w.pdb")
evaluate (&filenames.bestfile_12="PREVIT:complex_132w.pdb")
evaluate (&filenames.bestfile_13="PREVIT:complex_183w.pdb")
